# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA vai para o Git. Este .env.example vai, e serve de documentação.

PORT=3333

# Pegue em https://developer.riotgames.com (a chave de dev expira em 24h)
RIOT_API_KEY=

# americas | europe | asia | sea
RIOT_REGION=americas

# Origem autorizada a chamar esta API (o Vite roda em 5173)
CORS_ORIGIN=http://localhost:5173
